# URL pública del gateway (lo que usa el navegador). Usar "localhost", no "127.0.0.1",
# para que la cookie pc_session se comparta entre :4321 y :8080.
PUBLIC_API_URL=http://localhost:8080
# Opcional: URL del gateway vista desde el servidor SSR de Astro (p. ej. http://gateway:8080 en docker).
# Si no se define se usa PUBLIC_API_URL.
API_INTERNAL_URL=

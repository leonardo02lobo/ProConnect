---
import SignUpAndInLayout from "../layouts/SignUpAndInLayout.astro";
---

<SignUpAndInLayout title="Sign Up">
    <div class="flex m-auto items-center justify-center h-screen">
        <form class="flex flex-col justify-center items-center gap-4 shadow-2xl shadow-black p-4 rounded-2xl" id="form">
            <label for="emailUsername" class="flex flex-col gap-3">
                Email
                <input type="text" placeholder="insert your email" class="w-full/2 border border-gray-300 rounded-xl p-3 text-lg outline-none focus:border-blue-500" id="email">
            </label>
            <label for="password" class="flex flex-col gap-3">
                Password
                <input type="password" placeholder="insert your password" class="w-full/2 border border-gray-300 rounded-xl p-3 text-lg outline-none focus:border-blue-500" id="password">
            </label>
            <button class="bg-blue-600 hover:bg-blue-700 rounded-2xl px-4 py-3 text-lg text-white cursor-pointer w-full">
                Sign Up
            </button>
            <p>¿ Do not have account ?. <a href="/SignIn" class="text-blue-600">Create account</a></p>
        </form>
    </div>

    <script>
        import { AuthApi } from "../Service/AuthApi";

        document.getElementById("form")?.addEventListener("submit", async (e) => {
            e.preventDefault()

            const email = document.getElementById("email") as HTMLInputElement
            const password = document.getElementById("password") as HTMLInputElement

            const response: Response = await AuthApi.Login(email.value,password.value)
            if (response.ok) {
                    const data = await response.json()
                    cookieStore.set("user",JSON.stringify(data.userDto))
                    location.href = "/"
                } else {
                    console.error("Error:", response.statusText);
                }
        });
    </script>
</SignUpAndInLayout>
# API core (Spring Boot) - copiar a .env y ajustar. No commitear .env.
SERVER_PORT=8081
DB_URL=jdbc:mysql://localhost:3306/proconnect
DB_USER=proconnect
DB_PASSWORD=change-me
# Mínimo 32 bytes; mismo valor en gateway/. Generar con: openssl rand -base64 48
JWT_SECRET=change-me-to-a-random-secret-of-at-least-32-bytes
# Duración ISO-8601 del JWT y de la cookie pc_session
JWT_TTL=PT24H
# false SOLO en desarrollo local sobre http
COOKIE_SECURE=true
CORS_ORIGINS=http://localhost:4321
# IPs/CIDR de proxies de confianza para X-Forwarded-For (p. ej. la red Docker del gateway: 172.16.0.0/12)
TRUSTED_PROXIES=127.0.0.1/32,::1/128
# Fuerza bruta en /api/auth/**: peticiones/min por IP, fallos por cuenta antes del bloqueo y duración
RATE_LIMIT_AUTH_PER_MINUTE=10
RATE_LIMIT_MAX_FAILURES=5
RATE_LIMIT_LOCKOUT=PT15M
# SMTP de los correos de postulación (dev/E2E: Mailpit en localhost:1025, sin auth ni TLS)
MAIL_HOST=localhost
MAIL_PORT=1025
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_SMTP_AUTH=false
MAIL_STARTTLS=false
MAIL_SSL=false
MAIL_FROM="Respuesta a su solicitud de empleo" <no-reply@proconnect.local>
# Primer ADMIN (opcional): se crea al arrancar si no existe un usuario con ese email. Dejar vacío para desactivar.
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=
BOOTSTRAP_ADMIN_NAME=Administrador

# Gateway (Spring Cloud Gateway) - copiar a .env y ajustar. No commitear .env.
PORT=8080
API_URI=http://localhost:8081
MEDIA_URI=http://localhost:3001
# Orígenes permitidos separados por comas (nunca "*")
CORS_ORIGINS=http://localhost:4321
# Mismo valor que en backProconnect; mínimo 32 bytes. Generar con: openssl rand -base64 48
JWT_SECRET=change-me-to-a-random-secret-of-at-least-32-bytes
# CSP en Report-Only solo para diagnosticar (por defecto se aplica en enforce)
CSP_REPORT_ONLY=false
# HSTS: activar solo detrás de HTTPS (o usar SPRING_PROFILES_ACTIVE=prod)
HSTS_ENABLED=false

# Convenciones de editor compartidas por todo el repo (cleanup-codebase).
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{ts,tsx,js,mjs,cjs,astro,json,yml,yaml,css,md}]
indent_size = 2

[FrontedProConnect/**.{ts,tsx,astro}]
indent_size = 4

[*.md]
trim_trailing_whitespace = false

[Makefile]
indent_style = tab

[*.{cmd,bat}]
end_of_line = crlf
